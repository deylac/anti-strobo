# Clé d'API App Store Connect utilisée par scripts/testflight.sh.
# Copie ce fichier en `.env.local` (jamais versionné) puis renseigne les trois valeurs.
#
# La clé se crée dans App Store Connect > Utilisateurs et accès > Intégrations > App Store Connect API
# (rôle App Manager ou Admin). Garde le fichier .p8 hors du dépôt.
#
# ASC_KEY_ID           identifiant de la clé (10 caractères)
# ASC_ISSUER_ID        identifiant de l'émetteur (UUID, page Clés d'App Store Connect)
# ASC_PRIVATE_KEY_PATH chemin du fichier AuthKey_XXXX.p8 (entre guillemets s'il contient des espaces)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=
