<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Options d'export de `xcodebuild -exportArchive` pour TestFlight (testeurs internes uniquement).
     Utilisé par scripts/testflight.sh : l'export envoie directement le build à App Store Connect.
     Signature manuelle : avec une clé d'API, la signature automatique passe par les certificats gérés par Apple
     (« Cloud signing permission error » si la clé n'y a pas accès). On signe donc avec le certificat Apple
     Distribution du trousseau et le profil App Store « Anti-Strobo App Store » de l'équipe. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>P55APCSVXL</string>
	<key>testFlightInternalTestingOnly</key>
	<true/>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>app.camantistrobo.ios</key>
		<string>Anti-Strobo App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
